-- Simple ability cooldown
local lastCast = {}

remote.OnServerEvent:Connect(function(player)
	local now = os.clock()
	if lastCast[player] and now - lastCast[player] < 5 then
		return
	end
	lastCast[player] = now

	local character = player.Character
	local playerRoot = character and character:FindFirstChild("HumanoidRootPart")
	if not playerRoot then return end

	-- Guardian appears behind the player
	local guardian = Instance.new("Model")
	guardian.Name = "VoidKnight"
	guardian.Parent = map

	local base = playerRoot.CFrame * CFrame.new(3, 0, 3)

	local body = part("GuardianBody", Vector3.new(2.5, 4, 1.5),
		base * CFrame.new(0, 2, 0), purple, Enum.Material.Neon, guardian)
	body.CanCollide = false

	local headPart = part("GuardianHead", Vector3.new(2, 2, 2),
		base * CFrame.new(0, 5, 0), dark, Enum.Material.SmoothPlastic, guardian)
	headPart.CanCollide = false

	local eye1 = part("EyeLeft", Vector3.new(0.35, 0.25, 0.15),
		base * CFrame.new(-0.4, 5, -1), cyan, Enum.Material.Neon, guardian)
	eye1.CanCollide = false

	local eye2 = part("EyeRight", Vector3.new(0.35, 0.25, 0.15),
		base * CFrame.new(0.4, 5, -1), cyan, Enum.Material.Neon, guardian)
	eye2.CanCollide = false

	for _, side in ipairs({-1, 1}) do
		local wing = part("EnergyWing", Vector3.new(0.6, 3.5, 1),
			base * CFrame.new(side * 2, 2.8, 0),
			cyan, Enum.Material.Neon, guardian)
		wing.CanCollide = false
	end

	-- Energy projectile
	local orb = part("VoidProjectile", Vector3.new(2, 2, 2),
		CFrame.new(body.Position), cyan, Enum.Material.Neon)
	orb.Shape = Enum.PartType.Ball
	orb.CanCollide = false
	orb.Anchored = true

	local targetPosition = root.Position + Vector3.new(0, 1, 0)
	local distance = (targetPosition - orb.Position).Magnitude
	local duration = math.clamp(distance / 75, 0.15, 0.7)

	local tween = TweenService:Create(
		orb,
		TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{Position = targetPosition}
	)
	tween:Play()

	tween.Completed:Connect(function()
		if orb.Parent then
			-- Damage the training target only
			if hum.Health > 0 then
				hum:TakeDamage(25)
			end

			local burst = part("ImpactBurst", Vector3.new(1, 1, 1),
				CFrame.new(targetPosition), cyan, Enum.Material.Neon)
			burst.Shape = Enum.PartType.Ball
			burst.CanCollide = false

			TweenService:Create(
				burst,
				TweenInfo.new(0.25),
				{Size = Vector3.new(8, 8, 8), Transparency = 1}
			):Play()

			Debris:AddItem(burst, 0.35)
			orb:Destroy()
		end
	end)

	Debris:AddItem(guardian, 1.5)
	Debris:AddItem(orb, 2)
end)

Players.PlayerRemoving:Connect(function(player)
	lastCast[player] = nil
end)

print("Awakening Demo ready!")
