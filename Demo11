-- Short-lived visual effects
local function burst(position)
    local ring = makePart(
        "ImpactRing",
        Vector3.new(1, 0.18, 1),
        CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90)),
        Color3.fromRGB(40, 220, 255),
        Enum.Material.Neon
    )
    ring.Shape = Enum.PartType.Cylinder
    ring.CanCollide = false

    local light = Instance.new("PointLight")
    light.Color = Color3.fromRGB(65, 190, 255)
    light.Brightness = 3
    light.Range = 12
    light.Parent = ring

    TweenService:Create(
        ring,
        TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        {Size = Vector3.new(1, 0.18, 8), Transparency = 1}
    ):Play()

    Debris:AddItem(ring, 0.5)

    for i = 1, 6 do
        local angle = (math.pi * 2 / 6) * i
        local orb = makePart(
            "ImpactSpark",
            Vector3.new(0.35, 0.35, 0.35),
            CFrame.new(position),
            Color3.fromRGB(170, 100, 255),
            Enum.Material.Neon
        )
        orb.Shape = Enum.PartType.Ball
        orb.CanCollide = false

        local destination = position + Vector3.new(
            math.cos(angle) * 3,
            math.random() * 2,
            math.sin(angle) * 3
        )

        TweenService:Create(
            orb,
            TweenInfo.new(0.3),
            {Position = destination, Transparency = 1, Size = Vector3.new(0.05, 0.05, 0.05)}
        ):Play()

        Debris:AddItem(orb, 0.4)
    end
end

local function summonKnight(player, character)
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local model = Instance.new("Model")
    model.Name = "VoidKnightEffect"

    local base = hrp.CFrame * CFrame.new(3, 0, 2)
    local purple = Color3.fromRGB(105, 45, 210)
    local cyan = Color3.fromRGB(35, 210, 255)

    local function knightPart(name, size, offset, color, shape)
        local p = Instance.new("Part")
        p.Name = name
        p.Size = size
        p.CFrame = base * CFrame.new(offset)
        p.Color = color
        p.Material = Enum.Material.Neon
        p.Anchored = true
        p.CanCollide = false
        p.Shape = shape or Enum.PartType.Block
        p.Transparency = 1
        p.Parent = model
        return p
    end

    local torsoPart = knightPart(
        "Armor", Vector3.new(1.8, 2.4, 0.9),
        Vector3.new(0, 2.7, 0), purple
    )
    local headPart = knightPart(
        "Helmet", Vector3.new(1.3, 1.3, 1.1),
        Vector3.new(0, 4.5, 0), purple, Enum.PartType.Ball
    )
    knightPart("LeftEye", Vector3.new(0.35, 0.12, 0.12),
        Vector3.new(-0.25, 4.55, -0.55), cyan)
    knightPart("RightEye", Vector3.new(0.35, 0.12, 0.12),
        Vector3.new(0.25, 4.55, -0.55), cyan)
    knightPart("LeftShoulder", Vector3.new(0.85, 0.85, 0.9),
        Vector3.new(-1.2, 3.25, 0), purple, Enum.PartType.Ball)
    knightPart("RightShoulder", Vector3.new(0.85, 0.85, 0.9),
        Vector3.new(1.2, 3.25, 0), purple, Enum.PartType.Ball)
    knightPart("LeftArm", Vector3.new(0.55, 1.7, 0.6),
        Vector3.new(-1.15, 2.1, 0), purple)
    knightPart("RightArm", Vector3.new(0.55, 1.7, 0.6),
        Vector3.new(1.15, 2.1, 0), purple)
    knightPart("LeftLeg", Vector3.new(0.65, 1.6, 0.7),
        Vector3.new(-0.48, 0.75, 0), purple)
    knightPart("RightLeg", Vector3.new(0.65, 1.6, 0.7),
        Vector3.new(0.48, 0.75, 0), purple)

    model.Parent = area

    for _, part in ipairs(model:GetChildren()) do
        if part:IsA("BasePart") then
            TweenService:Create(
                part,
                TweenInfo.new(0.22),
                {Transparency = 0}
            ):Play()
        end
    end

    local glow = Instance.new("PointLight")
    glow.Color = purple
    glow.Brightness = 2
    glow.Range = 12
    glow.Parent = torsoPart

    local aura = makePart(
        "SummonAura",
        Vector3.new(0.2, 4.8, 4.8),
        base * CFrame.new(0, 2.2, 0) * CFrame.Angles(0, 0, math.rad(90)),
        purple,
        Enum.Material.Neon
    )
    aura.Shape = Enum.PartType.Cylinder
    aura.Transparency = 0.55
    aura.CanCollide = false

    TweenService:Create(
        aura,
        TweenInfo.new(0.5),
        {Transparency = 1, Size = Vector3.new(0.2, 7, 7)}
    ):Play()

    Debris:AddItem(aura, 0.6)
    Debris:AddItem(model, 1.4)
end

local lastUse = {}

Players.PlayerRemoving:Connect(function(player)
    lastUse[player] = nil
end)

remote.OnServerEvent:Connect(function(player)
    local now = os.clock()
    if lastUse[player] and now - lastUse[player] < COOLDOWN then
        return
    end

    local character = player.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local playerHumanoid = character and character:FindFirstChildOfClass("Humanoid")

    if not hrp or not playerHumanoid or playerHumanoid.Health <= 0 then
        return
    end

    lastUse[player] = now
    summonKnight(player, character)

    -- Projectile starts near the player and travels to the dummy.
    local startPos = hrp.Position + hrp.CFrame.LookVector * 3 + Vector3.new(0, 2, 0)
    local targetPos = root.Position + Vector3.new(0, 2.5, 0)

    local projectile = makePart(
        "VoidEnergyProjectile",
        Vector3.new(1.1, 1.1, 1.1),
        CFrame.new(startPos),
        Color3.fromRGB(35, 220, 255),
        Enum.Material.Neon
    )
    projectile.Shape = Enum.PartType.Ball
    projectile.CanCollide = false

    local light = Instance.new("PointLight")
    light.Color = projectile.Color
    light.Brightness = 3
    light.Range = 10
    light.Parent = projectile

    TweenService:Create(
        projectile,
        TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
        {Position = targetPos, Size = Vector3.new(0.25, 0.25, 0.25)}
    ):Play()

    task.delay(0.4, function()
        if projectile.Parent then
            burst(targetPos)
            projectile:Destroy()
        end

        if humanoid.Parent and humanoid.Health > 0 then
            humanoid:TakeDamage(DAMAGE)
        end
    end)
end)

