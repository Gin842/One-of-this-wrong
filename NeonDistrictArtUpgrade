
-- NEON DISTRICT: ART DIRECTION UPGRADE
-- Keep NeonDistrictServer and NeonDistrictClient unchanged.
-- This script decorates the existing world after it is generated.

local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")

local CYAN = Color3.fromRGB(50, 225, 255)
local PURPLE = Color3.fromRGB(167, 75, 255)
local GOLD = Color3.fromRGB(255, 190, 90)
local NIGHT = Color3.fromRGB(18, 21, 36)
local DARK_METAL = Color3.fromRGB(30, 35, 52)
local GLASS = Color3.fromRGB(30, 100, 125)

-- Wait for the existing world generator.
local world
for i = 1, 60 do
	world = Workspace:FindFirstChild("NeonDistrict")
	if world then break end
	task.wait(0.5)
end

if not world then
	warn("NeonDistrictArtUpgrade: NeonDistrict was not found.")
	return
end

-- Recreate only our own decoration folder.
local old = world:FindFirstChild("NeonDistrictArt")
if old then old:Destroy() end

local art = Instance.new("Folder")
art.Name = "NeonDistrictArt"
art.Parent = world

-- Original palette and atmospheric identity.
Lighting.ClockTime = 0
Lighting.Brightness = 1.5
Lighting.Ambient = Color3.fromRGB(48, 42, 78)
Lighting.OutdoorAmbient = Color3.fromRGB(25, 30, 55)
Lighting.EnvironmentDiffuseScale = 0.35
Lighting.EnvironmentSpecularScale = 0.6

local function effect(className, name)
	local obj = Lighting:FindFirstChild(name)
	if not obj then
		obj = Instance.new(className)
		obj.Name = name
		obj.Parent = Lighting
	end
	return obj
end

local atmosphere = effect("Atmosphere", "NeonDistrictAtmosphere")
atmosphere.Density = 0.28
atmosphere.Offset = 0.1
atmosphere.Color = Color3.fromRGB(135, 140, 210)
atmosphere.Decay = Color3.fromRGB(42, 20, 75)
atmosphere.Glare = 0.25
atmosphere.Haze = 1.5

local bloom = effect("BloomEffect", "NeonDistrictBloom")
bloom.Intensity = 0.45
bloom.Size = 24
bloom.Threshold = 1.15

local grade = effect("ColorCorrectionEffect", "NeonDistrictGrade")
grade.Brightness = -0.03
grade.Contrast = 0.18
grade.Saturation = 0.12
grade.TintColor = Color3.fromRGB(207, 207, 255)

-- Improve the materials of existing city pieces without replacing them.
for _, obj in ipairs(world:GetDescendants()) do
	if obj:IsA("BasePart") then
		local n = string.lower(obj.Name)

		if string.find(n, "floor") or string.find(n, "ground")
			or string.find(n, "road") or string.find(n, "street") then
			obj.Material = Enum.Material.Asphalt
			obj.Color = Color3.fromRGB(29, 32, 47)

		elseif string.find(n, "roof") then
			obj.Material = Enum.Material.Slate
			obj.Color = Color3.fromRGB(25, 26, 43)

		elseif string.find(n, "building") then
			obj.Material = Enum.Material.Concrete
			obj.Color = Color3.fromRGB(39, 43, 62)

		elseif string.find(n, "shelf") then
			obj.Material = Enum.Material.Metal
			obj.Color = DARK_METAL

		elseif string.find(n, "door") then
			obj.Material = Enum.Material.Metal
			obj.Color = Color3.fromRGB(34, 40, 57)

		elseif string.find(n, "sign") then
			obj.Material = Enum.Material.Metal
			obj.Color = NIGHT
		end
	end
end

local function makePart(name, size, cf, color, material, parent)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.CanCollide = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent or art
	return p
end

local function addGlow(part, color, brightness, range)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Brightness = brightness
	light.Range = range
	light.Shadows = false
	light.Parent = part
end

local function addSurfaceText(part, text, color)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "NeonSignSurface"
	gui.Face = Enum.NormalId.Front
	gui.CanvasSize = Vector2.new(700, 180)
	gui.LightInfluence = 0
	gui.Parent = part

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextColor3 = color
	label.TextStrokeTransparency = 0.35
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.Parent = gui
end

-- Give the weapon shop a layered neon entrance.
local shop = world:FindFirstChild("WeaponShop", true)
local door = shop and shop:FindFirstChild("Door", true)

if shop and door and door:IsA("BasePart") then
	local cf = door.CFrame
	local w = math.max(door.Size.X, 3)
	local h = math.max(door.Size.Y, 5)

	-- The front is based on the existing door's orientation.
	-- Local negative Z is the door's front.
	local front = cf * CFrame.new(0, 0, -0.8)

	-- Side pillars with luminous trim.
	for _, side in ipairs({-1, 1}) do
		local pillar = makePart(
			"ShopEntrancePillar",
			Vector3.new(0.32, h + 1.2, 0.45),
			front * CFrame.new(side * (w / 2 + 0.42), 0, 0),
			DARK_METAL,
			Enum.Material.Metal
		)

		local strip = makePart(
			"NeonPillarTrim",
			Vector3.new(0.07, h + 0.7, 0.08),
			pillar.CFrame * CFrame.new(-side * 0.08, 0, -0.25),
			side == -1 and CYAN or PURPLE,
			Enum.Material.Neon
		)
		addGlow(strip, strip.Color, 0.6, 7)
	end

	-- Floating canopy.
	local canopy = makePart(
		"WeaponShopCanopy",
		Vector3.new(w + 2.2, 0.28, 1.8),
		front * CFrame.new(0, h / 2 + 0.9, -0.25),
		DARK_METAL,
		Enum.Material.Metal
	)

	makePart(
		"CanopyGlow",
		Vector3.new(w + 1.8, 0.08, 1.5),
		canopy.CFrame * CFrame.new(0, -0.18, 0),
		CYAN,
		Enum.Material.Neon
	)

	-- Custom sign above the entrance.
	local signCF = front * CFrame.new(0, h / 2 + 2.0, -0.3)
	local sign = makePart(
		"NeonDistrictWeaponSign",
		Vector3.new(w + 2.6, 0.9, 0.22),
		signCF,
		NIGHT,
		Enum.Material.Metal
	)
	addSurfaceText(sign, "ARSENAL  /  01", CYAN)
	addGlow(sign, CYAN, 1.1, 12)

	-- Small entrance platform and glowing edge.
	local floorY = door.Position.Y - door.Size.Y / 2 - 0.15
	local padCF = CFrame.new(
		door.Position.X,
		floorY,
		door.Position.Z
	) * (cf - cf.Position) * CFrame.new(0, 0, -3.2)

	local pad = makePart(
		"WeaponShopEntrancePad",
		Vector3.new(w + 3, 0.22, 5.5),
		padCF,
		Color3.fromRGB(35, 39, 58),
		Enum.Material.Slate
	)

	for _, side in ipairs({-1, 1}) do
		local edge = makePart(
			"EntranceLightLine",
			Vector3.new(0.08, 0.05, 5.2),
			pad.CFrame * CFrame.new(side * (w / 2 + 1.35), 0.14, 0),
			side == -1 and CYAN or PURPLE,
			Enum.Material.Neon
		)
		addGlow(edge, edge.Color, 0.35, 5)
	end

	-- Decorative gold emblem plate.
	local emblem = makePart(
		"ArsenalEmblem",
		Vector3.new(0.7, 0.7, 0.12),
		sign.CFrame * CFrame.new(0, 0, -0.18),
		GOLD,
		Enum.Material.Neon
	)
	emblem.Shape = Enum.PartType.Cylinder
	emblem.CFrame = emblem.CFrame * CFrame.Angles(0, 0, math.rad(90))

	print("Neon District: weapon shop facade upgraded")
else
	warn("WeaponShop or its BasePart Door was not found; shop facade skipped.")
end

-- Add lightweight neon street lanterns near the weapon shop.
-- They are decorative only and do not block player movement.
if door and door:IsA("BasePart") then
	for i, side in ipairs({-1, 1}) do
		local baseCF = door.CFrame * CFrame.new(side * 8, 0, -6)

		local base = makePart(
			"DistrictLanternBase",
			Vector3.new(0.9, 0.25, 0.9),
			CFrame.new(baseCF.Position.X, door.Position.Y - door.Size.Y / 2, baseCF.Position.Z),
			DARK_METAL,
			Enum.Material.Metal
		)

		local pole = makePart(
			"DistrictLanternPole",
			Vector3.new(0.18, 5.5, 0.18),
			base.CFrame * CFrame.new(0, 2.85, 0),
			DARK_METAL,
			Enum.Material.Metal
		)

		local lamp = makePart(
			"DistrictLanternGlow",
			Vector3.new(1.0, 0.22, 0.55),
			pole.CFrame * CFrame.new(0, 2.7, 0),
			i == 1 and CYAN or PURPLE,
			Enum.Material.Neon
		)
		addGlow(lamp, lamp.Color, 1.3, 16)
	end
end

print("NEON DISTRICT ART UPGRADE COMPLETE")
