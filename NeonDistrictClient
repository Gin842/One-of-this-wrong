
-- NeonDistrictClient
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local remote = ReplicatedStorage:WaitForChild("RPGEvent")

local gui = Instance.new("ScreenGui")
gui.Name = "NeonRPGHUD"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local function label(name, text, pos, size)
    local l = Instance.new("TextLabel")
    l.Name = name
    l.Text = text
    l.Position = pos
    l.Size = size
    l.BackgroundColor3 = Color3.fromRGB(18, 18, 35)
    l.BackgroundTransparency = 0.12
    l.TextColor3 = Color3.fromRGB(240, 245, 255)
    l.Font = Enum.Font.GothamBold
    l.TextScaled = true
    l.Parent = gui
    return l
end

local hp = label("HP", "HP: --", UDim2.new(0, 20, 1, -105),
    UDim2.fromOffset(230, 30))
local mp = label("MP", "MP: 100 / 100", UDim2.new(0, 20, 1, -68),
    UDim2.fromOffset(230, 30))
local persona = label("Persona", "PERSONA: VOID KNIGHT",
    UDim2.new(0.5, -160, 0, 20), UDim2.fromOffset(320, 38))
local notice = label("Notice", "", UDim2.new(0.5, -180, 0.18, 0),
    UDim2.fromOffset(360, 42))
notice.Visible = false

local function button(text, pos, callback)
    local b = Instance.new("TextButton")
    b.Size = UDim2.fromOffset(155, 42)
    b.Position = pos
    b.BackgroundColor3 = Color3.fromRGB(75, 35, 125)
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Font = Enum.Font.GothamBold
    b.TextScaled = true
    b.Text = text
    b.Parent = gui
    b.Activated:Connect(callback)
    return b
end

button("SUMMON  [E]", UDim2.new(1, -175, 1, -110), function()
    remote:FireServer("Summon")
end)

button("SWITCH  [Q]", UDim2.new(1, -175, 1, -60), function()
    remote:FireServer("Switch")
end)

local personaNames = {"VOID KNIGHT", "STAR WARDEN", "CRIMSON REAPER"}

local function updateHUD()
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        hp.Text = "HP: " .. math.floor(humanoid.Health)
            .. " / " .. math.floor(humanoid.MaxHealth)
    end

    mp.Text = "MP: " .. tostring(player:GetAttribute("MP") or 100)
        .. " / " .. tostring(player:GetAttribute("MaxMP") or 100)

    local index = player:GetAttribute("PersonaIndex") or 1
    persona.Text = "PERSONA: " .. personaNames[index]
end

player:GetAttributeChangedSignal("MP"):Connect(updateHUD)
player:GetAttributeChangedSignal("PersonaIndex"):Connect(updateHUD)

local function hookCharacter(character)
    local humanoid = character:WaitForChild("Humanoid")
    humanoid.HealthChanged:Connect(updateHUD)
    updateHUD()
end

player.CharacterAdded:Connect(hookCharacter)
if player.Character then hookCharacter(player.Character) end

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.E then
        remote:FireServer("Summon")
    elseif input.KeyCode == Enum.KeyCode.Q then
        remote:FireServer("Switch")
    end
end)

remote.OnClientEvent:Connect(function(action, message)
    if action == "Notice" then
        notice.Text = message
        notice.Visible = true
        task.delay(2.5, function()
            notice.Visible = false
        end)
    end
end)
