local finishCooldown = {}
finish.Touched:Connect(function(hit)
    local character = hit.Parent
    local player = Players:GetPlayerFromCharacter(character)
    if not player or finishCooldown[player] then return end

    finishCooldown[player] = true
    local stats = player:FindFirstChild("leaderstats")
    local coins = stats and stats:FindFirstChild("Coins")
    if coins then
        local reward = math.random(10, 30)
        coins.Value += reward
        remote:FireClient(player, "Notice",
            "OBBY COMPLETE! +" .. reward .. " Coins")
    end

    task.delay(8, function()
        finishCooldown[player] = nil
    end)
end)

-- Player data and Persona state
local personas = {"VoidKnight", "StarWarden", "CrimsonReaper"}

local function setupPlayer(player)
    local stats = Instance.new("Folder")
    stats.Name = "leaderstats"
    stats.Parent = player

    local coins = Instance.new("IntValue")
    coins.Name = "Coins"
    coins.Value = 100
    coins.Parent = stats

    player:SetAttribute("MP", 100)
    player:SetAttribute("MaxMP", 100)
    player:SetAttribute("PersonaIndex", 1)
end

Players.PlayerAdded:Connect(setupPlayer)
for _, player in ipairs(Players:GetPlayers()) do
    if not player:FindFirstChild("leaderstats") then
        setupPlayer(player)
    end
end

local colors = {
    Color3.fromRGB(130, 55, 255),
    Color3.fromRGB(40, 220, 255),
    Color3.fromRGB(255, 55, 85)
}

local names = {"VoidKnight", "StarWarden", "CrimsonReaper"}
local busy = {}

local function summon(player)
    if busy[player] then return end
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local mp = player:GetAttribute("MP") or 100
    if mp < 20 then
        remote:FireClient(player, "Notice", "Not enough MP!")
        return
    end

    busy[player] = true
    player:SetAttribute("MP", mp - 20)

    local index = player:GetAttribute("PersonaIndex") or 1
    local color = colors[index]
    local model = Instance.new("Model")
    model.Name = names[index] .. "_Summon"
    model.Parent = world

    local base = root.CFrame * CFrame.new(4, 0, -3)
    local function summonPart(name, size, offset, c, material)
        local p = Instance.new("Part")
        p.Name = name
        p.Size = size
        p.Color = c
        p.Material = material or Enum.Material.Neon
        p.Anchored = true
        p.CanCollide = false
        p.CFrame = base * CFrame.new(offset)
        p.Parent = model
        return p
    end

    -- Three silhouettes use different colors and shapes.
    summonPart("Body", Vector3.new(2.2, 3.5, 1.2),
        Vector3.new(0, 3.5, 0), color)
    summonPart("Head", Vector3.new(1.8, 1.8, 1.8),
        Vector3.new(0, 6.2, 0), Color3.fromRGB(25, 25, 40))
    summonPart("LeftEye", Vector3.new(0.35, 0.2, 0.15),
        Vector3.new(-0.4, 6.3, -0.92), color)
    summonPart("RightEye", Vector3.new(0.35, 0.2, 0.15),
        Vector3.new(0.4, 6.3, -0.92), color)

    if index == 1 then
        summonPart("HornL", Vector3.new(0.35, 2, 0.35),
            Vector3.new(-0.8, 7.4, 0), color)
        summonPart("HornR", Vector3.new(0.35, 2, 0.35),
            Vector3.new(0.8, 7.4, 0), color)
    elseif index == 2 then
        summonPart("Halo", Vector3.new(3, 0.25, 3),
            Vector3.new(0, 8, 0), color)
        summonPart("WingL", Vector3.new(2.5, 3, 0.5),
            Vector3.new(-2, 4, 0), color)
        summonPart("WingR", Vector3.new(2.5, 3, 0.5),
            Vector3.new(2, 4, 0), color)
    else
        summonPart("Blade", Vector3.new(0.45, 5, 0.45),
            Vector3.new(2, 3.5, 0), color)
        summonPart("ShoulderL", Vector3.new(1.6, 1, 1.6),
            Vector3.new(-1.5, 5, 0), color)
        summonPart("ShoulderR", Vector3.new(1.6, 1, 1.6),
            Vector3.new(1.5, 5, 0), color)
    end

    remote:FireClient(player, "Notice", names[index] .. " summoned!")

    -- Fade out after the reveal
    task.wait(2.5)
    for _, p in ipairs(model:GetChildren()) do
        if p:IsA("BasePart") then
            TweenService:Create(p, TweenInfo.new(0.6),
                {Transparency = 1}):Play()
        end
    end
    task.wait(0.7)
    model:Destroy()
    busy[player] = nil
end

remote.OnServerEvent:Connect(function(player, action)
    if action == "Switch" then
        local index = (player:GetAttribute("PersonaIndex") or 1) % 3 + 1
        player:SetAttribute("PersonaIndex", index)
        remote:FireClient(player, "Notice",
            "Persona: " .. names[index])
    elseif action == "Summon" then
        task.spawn(summon, player)
    end
end)

Players.PlayerRemoving:Connect(function(player)
    finishCooldown[player] = nil
    busy[player] = nil
end)
