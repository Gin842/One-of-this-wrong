local function part(parent, name, size, pos, color, material)
    local p = Instance.new("Part")
    p.Name = name
    p.Size = size
    p.Position = pos
    p.Anchored = true
    p.Color = color
    p.Material = material or Enum.Material.SmoothPlastic
    p.TopSurface = Enum.SurfaceType.Smooth
    p.BottomSurface = Enum.SurfaceType.Smooth
    p.Parent = parent
    return p
end

local function neonLine(parent, name, size, pos, color)
    local p = part(parent, name, size, pos, color, Enum.Material.Neon)
    p.CanCollide = false
    return p
end

local function makeShop(name, pos, color, title)
    local m = Instance.new("Model")
    m.Name = name
    m.Parent = world

    part(m, "Building", Vector3.new(24, 16, 18),
        pos + Vector3.new(0, 8, 0), Color3.fromRGB(28, 28, 48))

    part(m, "Roof", Vector3.new(26, 1, 20),
        pos + Vector3.new(0, 16.5, 0), color, Enum.Material.Metal)

    part(m, "Door", Vector3.new(5, 9, 0.5),
        pos + Vector3.new(0, 4.5, -9.2), Color3.fromRGB(12, 14, 24))

    neonLine(m, "Sign", Vector3.new(18, 1, 0.4),
        pos + Vector3.new(0, 13, -9.4), color)

    local sign = Instance.new("BillboardGui")
    sign.Size = UDim2.fromOffset(220, 48)
    sign.StudsOffset = Vector3.new(0, 3, 0)
    sign.AlwaysOnTop = true
    sign.Parent = m.Sign

    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.Text = title
    label.TextScaled = true
    label.Font = Enum.Font.GothamBold
    label.TextColor3 = color
    label.Parent = sign

    -- Display shelves
    for i = -1, 1 do
        part(m, "DisplayShelf", Vector3.new(5, 1, 2),
            pos + Vector3.new(i * 6, 3, -5), Color3.fromRGB(60, 60, 80))
    end

    -- Simple original NPC
    local npc = Instance.new("Model")
    npc.Name = name .. "_NPC"
    npc.Parent = world

    local rootPos = pos + Vector3.new(0, 0, -14)
    local root = part(npc, "HumanoidRootPart",
        Vector3.new(2, 2, 1), rootPos + Vector3.new(0, 3, 0),
        Color3.fromRGB(30, 30, 40))
    root.Transparency = 1
    root.CanCollide = false

    local torso = part(npc, "Torso", Vector3.new(2, 2.5, 1),
        rootPos + Vector3.new(0, 3, 0), color)
    torso.CanCollide = false

    local head = part(npc, "Head", Vector3.new(1.5, 1.5, 1.5),
        rootPos + Vector3.new(0, 5, 0), Color3.fromRGB(235, 204, 180))
    head.CanCollide = false

    local hum = Instance.new("Humanoid")
    hum.DisplayName = title
    hum.Parent = npc
    npc.PrimaryPart = root

    -- Keep NPC parts stationary
    for _, obj in ipairs(npc:GetChildren()) do
        if obj:IsA("BasePart") then
            obj.Anchored = true
        end
    end

    return m
end

