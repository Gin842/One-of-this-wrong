
local function summon(player)
    if busy[player] then return end

    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if not root or not humanoid or humanoid.Health <= 0 then return end

    local mp = player:GetAttribute("MP") or 100
    if mp < 20 then
        remote:FireClient(player, "Notice", "Not enough MP!")
        return
    end

    local index = math.clamp(
        player:GetAttribute("PersonaIndex") or 1, 1, 3
    )

    busy[player] = true
    player:SetAttribute("MP", mp - 20)

    local names = {"VoidKnight", "StarWarden", "CrimsonReaper"}
    local accentColors = {
        Color3.fromRGB(171, 74, 255),
        Color3.fromRGB(65, 225, 255),
        Color3.fromRGB(255, 48, 78)
    }

    local accent = accentColors[index]
    local armor = Color3.fromRGB(30, 29, 45)
    local armorLight = Color3.fromRGB(62, 57, 82)
    local black = Color3.fromRGB(12, 11, 21)

    local model = Instance.new("Model")
    model.Name = names[index] .. "_Cinematic"
    model.Parent = world

    local base = root.CFrame * CFrame.new(4, 0, -3)
    local pieces = {}

    local function makePart(name, size, offset, color, material, shape)
        local p = Instance.new("Part")
        p.Name = name
        p.Size = size
        p.CFrame = base * CFrame.new(offset)
        p.Anchored = true
        p.CanCollide = false
        p.CanTouch = false
        p.CanQuery = false
        p.CastShadow = true
        p.Material = material or Enum.Material.SmoothPlastic
        p.Color = color or armor
        p.Transparency = 1

        if shape then
            p.Shape = shape
        end

        p.Parent = model
        return p
    end

    local function piece(name, size, offset, color, material, shape, finalTransparency)
        local p = makePart(name, size, offset, color, material, shape)

        table.insert(pieces, {
            part = p,
            target = p.CFrame,
            transparency = finalTransparency or 0
        })

        return p
    end

    local function wedge(name, size, offset, color, rotation)
        local p = Instance.new("WedgePart")
        p.Name = name
        p.Size = size
        p.CFrame = base * CFrame.new(offset) * (rotation or CFrame.new())
        p.Anchored = true
        p.CanCollide = false
        p.CanTouch = false
        p.CanQuery = false
        p.CastShadow = true
        p.Material = Enum.Material.SmoothPlastic
        p.Color = color or armor
        p.Transparency = 1
        p.Parent = model

        table.insert(pieces, {
            part = p,
            target = p.CFrame,
            transparency = 0
        })

        return p
    end

    -- Ground portal: two luminous rings and a central energy core.
    local function groundRing(name, diameter, thickness, transparency)
        local ring = makePart(
            name,
            Vector3.new(thickness, diameter, diameter),
            Vector3.new(0, 0.16, 0),
            accent,
            Enum.Material.Neon,
            Enum.PartType.Cylinder
        )

        ring.CFrame = ring.CFrame * CFrame.Angles(0, 0, math.rad(90))
        ring.Transparency = transparency
        return ring
    end

    local ringOuter = groundRing("PortalOuter", 11, 0.15, 0.15)
    local ringInner = groundRing("PortalInner", 7.5, 0.12, 0.25)

    local core = makePart(
        "EnergyCore",
        Vector3.new(1, 1, 1),
        Vector3.new(0, 3.5, 0),
        accent,
        Enum.Material.Neon,
        Enum.PartType.Ball
    )

    local light = Instance.new("PointLight")
    light.Color = accent
    light.Brightness = 0
    light.Range = 22
    light.Parent = core

    -- Main silhouette: layered armor instead of plain blocks.
    piece("TorsoCore", Vector3.new(2.1, 2.8, 1.05),
        Vector3.new(0, 3.9, 0), black)

    piece("ChestArmor", Vector3.new(2.3, 1.35, 1.22),
        Vector3.new(0, 4.35, -0.08), armorLight)

    piece("ChestSigil", Vector3.new(0.22, 1.2, 0.12),
        Vector3.new(0, 4.35, -0.72), accent, Enum.Material.Neon)

    piece("WaistArmor", Vector3.new(1.8, 0.65, 1.05),
        Vector3.new(0, 2.45, 0), armorLight)

    -- Head, mask and luminous eyes.
    piece("Helmet", Vector3.new(1.45, 1.55, 1.25),
        Vector3.new(0, 6.15, 0), black)

    piece("FaceMask", Vector3.new(1.05, 0.68, 0.18),
        Vector3.new(0, 5.98, -0.67), armorLight)

    piece("EyeL", Vector3.new(0.36, 0.13, 0.09),
        Vector3.new(-0.32, 6.18, -0.79), Color3.new(1, 1, 1),
        Enum.Material.Neon)

    piece("EyeR", Vector3.new(0.36, 0.13, 0.09),
        Vector3.new(0.32, 6.18, -0.79), Color3.new(1, 1, 1),
        Enum.Material.Neon)

    -- Shoulder armor and pointed silhouettes.
    piece("ShoulderL", Vector3.new(1.35, 0.95, 1.3),
        Vector3.new(-1.55, 4.8, 0), armorLight)

    piece("ShoulderR", Vector3.new(1.35, 0.95, 1.3),
        Vector3.new(1.55, 4.8, 0), armorLight)

    wedge("ShoulderSpikeL", Vector3.new(0.65, 1.15, 0.7),
        Vector3.new(-1.75, 5.45, 0), accent,
        CFrame.Angles(0, 0, math.rad(25)))

    wedge("ShoulderSpikeR", Vector3.new(0.65, 1.15, 0.7),
        Vector3.new(1.75, 5.45, 0), accent,
        CFrame.Angles(0, 0, math.rad(-25)))

    -- Arms with forearm guards and glowing accents.
    piece("ArmL", Vector3.new(0.62, 1.75, 0.72),
        Vector3.new(-1.55, 3.65, 0), black)

    piece("ArmR", Vector3.new(0.62, 1.75, 0.72),
        Vector3.new(1.55, 3.65, 0), black)

    piece("GauntletL", Vector3.new(0.76, 0.9, 0.85),
        Vector3.new(-1.58, 2.85, -0.04), armorLight)

    piece("GauntletR", Vector3.new(0.76, 0.9, 0.85),
        Vector3.new(1.58, 2.85, -0.04), armorLight)

    piece("GauntletGlowL", Vector3.new(0.12, 0.65, 0.12),
        Vector3.new(-1.58, 2.85, -0.49), accent, Enum.Material.Neon)

    piece("GauntletGlowR", Vector3.new(0.12, 0.65, 0.12),
        Vector3.new(1.58, 2.85, -0.49), accent, Enum.Material.Neon)

    -- Legs, knee guards and boots.
    piece("LegL", Vector3.new(0.78, 1.55, 0.85),
        Vector3.new(-0.62, 1.55, 0), black)

    piece("LegR", Vector3.new(0.78, 1.55, 0.85),
        Vector3.new(0.62, 1.55, 0), black)

    piece("KneeL", Vector3.new(0.85, 0.55, 0.95),
        Vector3.new(-0.62, 1.85, -0.12), armorLight)

    piece("KneeR", Vector3.new(0.85, 0.55, 0.95),
        Vector3.new(0.62, 1.85, -0.12), armorLight)

    piece("BootL", Vector3.new(0.9, 0.4, 1.1),
        Vector3.new(-0.62, 0.68, -0.12), armorLight)

    piece("BootR", Vector3.new(0.9, 0.4, 1.1),
        Vector3.new(0.62, 0.68, -0.12), armorLight)

    -- Three original signatures.
    if index == 1 then
        -- VoidKnight: horned shadow knight with a back crest.
        wedge("HornL", Vector3.new(0.42, 1.35, 0.45),
            Vector3.new(-0.48, 7.15, 0), accent,
            CFrame.Angles(0, 0, math.rad(18)))

        wedge("HornR", Vector3.new(0.42, 1.35, 0.45),
            Vector3.new(0.48, 7.15, 0), accent,
            CFrame.Angles(0, 0, math.rad(-18)))

        piece("BackCrest", Vector3.new(0.6, 2.8, 0.35),
            Vector3.new(0, 4.2, 0.8), armorLight)

        wedge("CrestTipL", Vector3.new(0.4, 1.6, 0.4),
            Vector3.new(-0.45, 5.1, 0.8), accent)

        wedge("CrestTipR", Vector3.new(0.4, 1.6, 0.4),
            Vector3.new(0.45, 5.1, 0.8), accent)

    elseif index == 2 then
        -- StarWarden: luminous halo and layered wing feathers.
        piece("Halo", Vector3.new(2.4, 0.16, 2.4),
            Vector3.new(0, 7.35, 0), accent, Enum.Material.Neon,
            Enum.PartType.Cylinder)

        for side = -1, 1, 2 do
            for i = 1, 3 do
                wedge(
                    "Wing" .. side .. "_" .. i,
                    Vector3.new(0.42, 1.5, 0.7),
                    Vector3.new(side * (1.7 + i * 0.42), 4.6 + i * 0.45, 0.5),
                    i == 1 and accent or armorLight,
                    CFrame.Angles(0, 0, math.rad(side * -18))
                )
            end
        end

        piece("StarEmblem", Vector3.new(0.7, 0.7, 0.16),
            Vector3.new(0, 4.35, -0.77), Color3.new(1, 1, 1),
            Enum.Material.Neon)

    else
        -- CrimsonReaper: crest, long blade and asymmetric armor.
        wedge("CrestL", Vector3.new(0.45, 1.25, 0.45),
            Vector3.new(-0.38, 7.05, 0), accent,
            CFrame.Angles(0, 0, math.rad(20)))

        wedge("CrestR", Vector3.new(0.45, 1.25, 0.45),
            Vector3.new(0.38, 7.05, 0), accent,
            CFrame.Angles(0, 0, math.rad(-20)))

        piece("BladeHandle", Vector3.new(0.25, 1.2, 0.25),
            Vector3.new(2.15, 2.85, -0.1), black)

        piece("ReaperBlade", Vector3.new(0.22, 3.6, 0.3),
            Vector3.new(2.15, 5.15, -0.1), accent, Enum.Material.Neon)

        wedge("BladeTip", Vector3.new(0.24, 0.75, 0.3),
            Vector3.new(2.15, 7.25, -0.1), accent)

        piece("AsymmetricPlate", Vector3.new(1.05, 1.35, 0.4),
            Vector3.new(-1.2, 4.0, -0.55), accent)
    end

    remote:FireClient(player, "CinematicStart", names[index])

    -- Energy build-up.
    TweenService:Create(light, TweenInfo.new(
        0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out
    ), {
        Brightness = 3.5
    }):Play()

    TweenService:Create(core, TweenInfo.new(
        0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out
    ), {
        Size = Vector3.new(3, 3, 3)
    }):Play()

    TweenService:Create(ringOuter, TweenInfo.new(
        0.75, Enum.EasingStyle.Quint, Enum.EasingDirection.Out
    ), {
        Size = Vector3.new(0.15, 13, 13),
        Transparency = 0.05
    }):Play()

    TweenService:Create(ringInner, TweenInfo.new(
        0.75, Enum.EasingStyle.Quint, Enum.EasingDirection.Out
    ), {
        Size = Vector3.new(0.12, 9, 9),
        Transparency = 0.1
    }):Play()

    task.wait(0.45)

    -- Reveal armor in a smooth rising wave.
    for i, item in ipairs(pieces) do
        local p = item.part
        local target = item.target

        p.CFrame = target * CFrame.new(0, -2.2, 0)

        local delayTime = (i - 1) * 0.025
        task.delay(delayTime, function()
            if not p.Parent then return end

            TweenService:Create(p, TweenInfo.new(
                0.48, Enum.EasingStyle.Back, Enum.EasingDirection.Out
            ), {
                CFrame = target,
                Transparency = item.transparency
            }):Play()
        end)
    end

    task.wait(0.9)

    -- Eyes flare at the reveal impact.
    for _, item in ipairs(pieces) do
        local p = item.part

        if p.Name == "EyeL" or p.Name == "EyeR" then
            TweenService:Create(p, TweenInfo.new(0.16), {
                Size = Vector3.new(0.45, 0.18, 0.12)
            }):Play()
        end
    end

    remote:FireClient(player, "CinematicImpact", names[index])

    task.wait(2.2)

    -- Fade the summon away.
    for _, item in ipairs(pieces) do
        if item.part.Parent then
            TweenService:Create(item.part, TweenInfo.new(
                0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.In
            ), {
                Transparency = 1
            }):Play()
        end
    end

    TweenService:Create(ringOuter, TweenInfo.new(0.5), {
        Transparency = 1
    }):Play()

    TweenService:Create(ringInner, TweenInfo.new(0.5), {
        Transparency = 1
    }):Play()

    TweenService:Create(core, TweenInfo.new(0.5), {
        Transparency = 1,
        Size = Vector3.new(0.2, 0.2, 0.2)
    }):Play()

    TweenService:Create(light, TweenInfo.new(0.4), {
        Brightness = 0
    }):Play()

    task.wait(0.6)

    model:Destroy()
    remote:FireClient(player, "CinematicEnd")
    busy[player] = nil
end
