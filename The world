local function newModel(parent, name)
    local model = Instance.new("Model")
    model.Name = name
    model.Parent = parent
    return model
end

local function part(parent, name, size, cf, color, material, shape, collide)
    local p = Instance.new("Part")
    p.Name = name
    p.Size = size
    p.CFrame = cf
    p.Color = color or C.Stone
    p.Material = material or MAT.Slate
    p.Anchored = true
    p.TopSurface = Enum.SurfaceType.Smooth
    p.BottomSurface = Enum.SurfaceType.Smooth
    p.CanCollide = collide ~= false
    p.CastShadow = true

    if shape then
        p.Shape = shape
    end

    p.Parent = parent
    return p
end

local function localPart(parent, name, size, baseCF, x, y, z,
    color, material, shape, rx, ry, rz, collide)

    local offset = CFrame.new(x, y, z)
        * CFrame.Angles(
            math.rad(rx or 0),
            math.rad(ry or 0),
            math.rad(rz or 0)
        )

    return part(
        parent, name, size, baseCF * offset,
        color, material, shape, collide
    )
end

local function neon(parent, name, size, cf, color)
    local p = part(parent, name, size, cf, color, MAT.Neon, nil, false)
    return p
end

local function localNeon(parent, name, size, baseCF, x, y, z, color, rx, ry, rz)
    return localPart(
        parent, name, size, baseCF, x, y, z,
        color, MAT.Neon, nil, rx, ry, rz, false
    )
end

local function pointLight(parent, color, brightness, range)
    local light = Instance.new("PointLight")
    light.Color = color
    light.Brightness = brightness
    light.Range = range
    light.Shadows = false
    light.Parent = parent
    return light
end

local function sign(parent, baseCF, text, x, y, z, width, height)
    local plate = localPart(
        parent, "Inscribed_Sign",
        Vector3.new(width, height, 0.7),
        baseCF, x, y, z, C.Black, MAT.Metal
    )

    local face = Instance.new("SurfaceGui")
    face.Name = "Sign_Surface"
    face.Face = Enum.NormalId.Front
    face.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
    face.PixelsPerStud = 35
    face.Parent = plate

    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = C.Gold
    label.TextScaled = true
    label.Font = Enum.Font.GothamBlack
    label.Parent = face

    local stroke = Instance.new("UIStroke")
    stroke.Color = C.Red
    stroke.Thickness = 1.5
    stroke.Parent = label

    return plate
end

