        local capsule = localPart(gallery, "Code_Display_Core",
            Vector3.new(2.6, 4.5, 2.6),
            baseCF, x, 15.1, 22, C.PurpleDark, MAT.Neon,
            Enum.PartType.Ball, 0, 0, 0, false)

        pointLight(capsule, C.Purple, 0.7, 8)

        localPart(gallery, "Capsule_Ring",
            Vector3.new(4.2, 0.3, 4.2),
            baseCF, x, 13.4, 22, C.Gold, MAT.Neon,
            Enum.PartType.Cylinder, 0, 0, 0, false)
    end

    sign(gallery, baseCF, "CODE GALLERY", 0, 19.2, 29.8, 18, 2.5)

    -- Obby: a small personal course with increasing heights.
    local obby = newModel(base, "FRACTURE_RUN")
    local startX = 19
    local startZ = 15

    localPart(obby, "Obby_Entrance",
        Vector3.new(10, 1, 8),
        baseCF, startX, 2.8, startZ, C.Black, MAT.Metal)

    sign(obby, baseCF, "FRACTURE RUN", startX, 7.5, startZ - 4.2, 11, 2)

    for i = 1, CONFIG.ObbySteps do
        local x = startX + ((i % 2 == 0) and -2 or 2)
        local z = startZ - i * 5
        local y = 3 + i * 1.4

        local platform = localPart(obby, "Obby_Platform_" .. i,
            Vector3.new(6, 1, 5),
            baseCF, x, y, z, C.StoneLight, MAT.Metal)

        localPart(obby, "Obby_Glow_" .. i,
            Vector3.new(5, 0.15, 0.35),
            baseCF, x, y + 0.6, z - 2.1,
            (i % 2 == 0) and C.Purple or C.Red,
            MAT.Neon, nil, 0, 0, 0, false)

        if i < CONFIG.ObbySteps then
            localPart(obby, "Obby_Side_Rune_" .. i,
                Vector3.new(0.4, 1.4, 0.4),
                baseCF, x + 3.1, y + 0.4, z,
                C.Gold, MAT.Neon, nil, 0, 0, 0, false)
        end
    end

    -- Final reward platform.
    localPart(obby, "Obby_Reward_Platform",
        Vector3.new(10, 1.5, 9),
        baseCF, startX, 15, startZ - 43, C.RedDark, MAT.Metal)

    local rewardGlow = localPart(obby, "Obby_Reward_Core",
        Vector3.new(3, 3, 3),
        baseCF, startX, 17.5, startZ - 43, C.Gold, MAT.Neon,
        Enum.PartType.Ball, 0, 0, 0, false)

    pointLight(rewardGlow, C.Gold, 1.2, 10)

    -- Decorative rune pylons at the rear corners.
    for _, x in ipairs({-25, 25}) do
        local pylon = localPart(base, "Domain_Rune_Pylon",
            Vector3.new(2, 9, 2),
            baseCF, x, 6, 22, C.Black, MAT.Basalt)

        localPart(base, "Pylon_Light",
            Vector3.new(0.5, 5, 0.5),
            baseCF, x, 6, 20.8, C.Purple, MAT.Neon, nil, 0, 0, 0, false)
    end

    -- Bridge from the base toward the central arena.
    localPart(base, "Nexus_Bridge",
        Vector3.new(12, 1.5, 100),
        baseCF, 0, 0.1, -80, C.Stone, MAT.Slate)

    for _, x in ipairs({-6, 6}) do
        localPart(base, "Bridge_Edge",
            Vector3.new(0.5, 0.5, 100),
            baseCF, x, 1, -80, C.Gold, MAT.Neon, nil, 0, 0, 0, false)
    end

    -- Bridge lamps.
    for i = 1, 5 do
        local z = -38 - i * 16

        local lamp = localPart(base, "Bridge_Lamp",
            Vector3.new(1.4, 1.4, 1.4),
            baseCF, 0, 2, z, C.Purple, MAT.Neon,
            Enum.PartType.Ball, 0, 0, 0, false)

        pointLight(lamp, C.Purple, 0.6, 9)
    end

    return base
end

