makePart("RightEye", Vector3.new(0.13, 0.055, 0.035),
	P(0.19, 3.76, -0.367), cyan, Enum.Material.Neon)

-- Arms
local leftArm = makePart("LeftArm", Vector3.new(0.32, 1.15, 0.38),
