
-- WeaponMerchantNPC
-- Separate from NeonDistrictServer
-- Builds a custom stylized merchant NPC.

local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local old = Workspace:FindFirstChild("WeaponMerchantNPC")
if old then
	old:Destroy()
end

local folder = Instance.new("Model")
folder.Name = "WeaponMerchantNPC"
folder.Parent = Workspace

local function makePart(name, size, position, color, material, shape)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Position = position
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.Shape = shape or Enum.PartType.Block
	part.Anchored = true
	part.CanCollide = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = folder
	return part
end

-- Change this position later to place the merchant
-- beside the weapon shop.
local origin = Vector3.new(0, 4, 0)

local function P(x, y, z)
	return origin + Vector3.new(x, y, z)
end

local dark = Color3.fromRGB(28, 30, 43)
local coat = Color3.fromRGB(42, 48, 68)
local skin = Color3.fromRGB(224, 177, 143)
local gold = Color3.fromRGB(232, 177, 75)
local cyan = Color3.fromRGB(66, 220, 255)

-- Legs
makePart("LeftLeg", Vector3.new(0.42, 1.35, 0.48),
	P(-0.27, 1.05, 0), dark)

makePart("RightLeg", Vector3.new(0.42, 1.35, 0.48),
