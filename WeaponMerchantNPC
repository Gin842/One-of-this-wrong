label.BackgroundTransparency = 1
label.Text = "WEAPON MERCHANT"
label.TextColor3 = cyan
label.TextStrokeTransparency = 0.35
label.TextScaled = true
label.Font = Enum.Font.GothamBold
label.Parent = gui

-- Simple idle breathing motion
local torso = folder:FindFirstChild("Torso")
local originalSize = torso.Size

task.spawn(function()
	while folder.Parent do
		local up = TweenService:Create(
			torso,
			TweenInfo.new(1.1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
			{Size = originalSize + Vector3.new(0, 0.035, 0)}
		)
		up:Play()
		up.Completed:Wait()

		if not folder.Parent then break end

		local down = TweenService:Create(
			torso,
			TweenInfo.new(1.1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
			{Size = originalSize}
		)
		down:Play()
		down.Completed:Wait()
	end
end)

print("Weapon Merchant NPC created")
